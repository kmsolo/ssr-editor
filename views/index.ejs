<%- include("partials/header", { title: "Dokument" }) %>
<h1>Dokument</h1>

<% if (docs.length === 0) { %>
    <p>Inga dokument ännu. <a href="/new">Skapa ditt första.</a></p>
<% } else { %>
    <ul class="doclist">
        <% docs.forEach(doc => { %>
            <li>
                <a href="/<%= doc.id %>"><%= doc.title %></a>
                <small>Uppdaterad <%= doc.updated_at %></small>
            </li>
        <% }) %>
    </ul>
<% } %>
<%- include("partials/footer") %>
